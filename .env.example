# Database
POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments

# RabbitMQ
RABBITMQ_DEFAULT_USER=payments
RABBITMQ_DEFAULT_PASS=payments
RABBITMQ_URL=amqp://payments:payments@rabbitmq:5672/

# HTTP API authentication
API_KEY=change-me-in-production

# Application settings
LOG_LEVEL=INFO
PAYMENT_SUCCESS_RATE=0.9
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_TIMEOUT_SECONDS=10
PAYMENT_MAX_ATTEMPTS=3
OUTBOX_MAX_RETRIES=10
OUTBOX_LOCK_SECONDS=30
# true only for local webhook receivers (localhost / private IPs)
ALLOW_PRIVATE_WEBHOOKS=false
